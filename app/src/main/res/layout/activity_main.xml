<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:text="CS2 Catalog"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:text="Bem-vindo ao catálogo do CS2!"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp" />

    <Button
        android:id="@+id/btnSkins"
        android:text="Ver Skins"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#1E88E5"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnStickers"
        android:text="Ver Stickers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#43A047"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnHighlights"
        android:text="Ver Highlights"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#FB8C00"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnCrates"
        android:text="Ver Crates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#8E24AA"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnAgents"
        android:text="Ver Agents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#E53935"
        android:textColor="#FFFFFF" />

</LinearLayout>
