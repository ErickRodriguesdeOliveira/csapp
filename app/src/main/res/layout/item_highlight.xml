<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#181822"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeColor="#333344"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/imgHighlight"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.35"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:background="#202030" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.65"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHighlightName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Souvenir Charm | Austin 2025 Highlight"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvHighlightInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Austin 2025 • Team Spirit vs MOUZ"
                android:textColor="#BBBBBB"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="2dp" />

            <TextView
                android:id="@+id/tvHighlightExtra"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Toque para ver o lance"
                android:textColor="#8888FF"
                android:textSize="12sp"
                android:paddingTop="6dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
